# Unicorn Stable — per-org instance env (offering C). Rendered by provision-org.sh.
# One of these per org, mode 600. NEVER committed. __PLACEHOLDER__ values are
# filled by the provisioner; SECRETS are freshly generated per org.

# --- identity ---------------------------------------------------------------
# Compose project + resource prefix. All containers/volumes/networks derive
# from this so N orgs coexist on one host without collision.
COMPOSE_PROJECT_NAME=stable-__SLUG__
STABLE_SLUG=__SLUG__

# The org's UUID. Stamped onto every room + Knowledge Base so isolation holds
# even if two orgs ever share storage. THIS is what flips the app from
# community (ownership-only) mode to per-org shared-org mode. REQUIRED for C.
STABLE_ORG_ID=__ORG_UUID__

# --- public surface ---------------------------------------------------------
# The org's hostnames (Traefik Host rules + cert). livekit/turn are separate
# subdomains because WebRTC needs its own endpoint.
STABLE_DOMAIN=__APP_DOMAIN__
LIVEKIT_DOMAIN=__LIVEKIT_DOMAIN__
TURN_DOMAIN=__TURN_DOMAIN__
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
LIVEKIT_PUBLIC_URL=__LIVEKIT_PUBLIC_URL__
CORS_ORIGINS=__CORS_ORIGINS__

# --- LiveKit media ports (THE hard multi-instance constraint) ---------------
# Each org's LiveKit needs its OWN UDP/TCP media ports — they cannot share.
# The provisioner allocates a non-overlapping block. 7880=API/WS, 7881=TCP
# fallback, 7882=UDP mux (the one that MUST be unique + firewall-opened).
LIVEKIT_PORT_API=__LK_API__
LIVEKIT_PORT_TCP=__LK_TCP__
LIVEKIT_PORT_UDP=__LK_UDP__

# --- production posture (inherited hardening) -------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- secrets (freshly generated per org; 32-48B random) ---------------------
POSTGRES_PASSWORD=__GEN__
REDIS_PASSWORD=__GEN__
LIVEKIT_API_KEY=__GEN_KEY__
LIVEKIT_API_SECRET=__GEN__
INTERNAL_AGENT_SECRET=__GEN__
UPLOAD_URL_SECRET=__GEN__
INCOMING_WEBHOOK_SECRET=__GEN__
VAPID_PUBLIC_KEY=__GEN_VAPID_PUB__
VAPID_PRIVATE_KEY=__GEN_VAPID_PRIV__
VAPID_SUBJECT=__VAPID_SUBJECT__

# --- shared platform (per-org values, but pointing at shared services) ------
# Keycloak: per-org realm OR client — see project_per_org_sso_design (Aaron's
# open decision). Fill after the realm/client is created.
KEYCLOAK_URL=__KEYCLOAK_URL__
KEYCLOAK_REALM=__KC_REALM__
KEYCLOAK_CLIENT_ID=__KC_CLIENT__
KEYCLOAK_CLIENT_SECRET=__KC_SECRET__

# Brigade: shared roster today, scoped per org via accessPolicy (open decision).
BRIGADE_BASE_URL=__BRIGADE_BASE_URL__
BRIGADE_API_KEY=__BRIGADE_KEY__
BRIGADE_WORKER_AGENT_NAME=stable-__SLUG__

# Metering: distinct org id → billing already flows per org.
METERING_REPORT_URL=__METERING_REPORT_URL__
STABLE_METERING_ORG_ID=__SLUG__
METERING_KEY=__BILLING_KEY__

# GPU fleet (shared, move-proof via gateway-canonical routing).
WHISPER_BASE_URL=__WHISPER_BASE_URL__
WHISPER_MODEL=whisper-1
KOKORO_BASE_URL=__KOKORO_BASE_URL__

# Optional email (Graph) — leave blank to disable invite emails.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=
