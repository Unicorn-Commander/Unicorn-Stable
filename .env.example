# =============================================================================
# Unicorn Stable — environment reference
# =============================================================================
# ./install.sh GENERATES a complete .env from this reference (secrets included)
# and preserves it across re-runs — you normally never write .env by hand.
# This file documents every variable, what actually requires it, and what
# happens when it is unset. "REQUIRED" below means the self-host stack
# (docker-compose.selfhost.yml) will not start or will not pass /health
# without it. Everything in the OPTIONAL sections defaults to OFF and the
# stack runs fine with it empty.
#
# The operator/production compose (docker-compose.yml) uses the same variable
# names; see DEPLOYMENT.md for the per-instance operator path.
# =============================================================================

# --- Topology (self-host compose only) ---------------------------------------
# Address browsers AND containers use to reach this machine. A LAN IP or DNS
# name — NOT "localhost" (containers would resolve it to themselves, which
# breaks the backend→Keycloak fetch and LiveKit media candidates).
STABLE_HOST=example.com
STABLE_PROJECT=stable-selfhost
# Every published port is remappable so the stack can coexist with anything
# else on the host (including a second Stable).
STABLE_WEB_PORT=8401
STABLE_BACKEND_PORT=8400
STABLE_LIVEKIT_WS_PORT=7880
STABLE_LIVEKIT_TCP_PORT=7881
STABLE_LIVEKIT_UDP_PORT=7882
STABLE_POSTGRES_PORT=5433
STABLE_REDIS_PORT=6381
# Which optional services run: "keycloak", "keycloak,agents", "agents" or "".
COMPOSE_PROFILES=keycloak

# --- Core secrets — REQUIRED (install.sh generates strong values) ------------
# Postgres password for the `stable` database user (also embedded in the
# DATABASE_URL the compose file assembles).
POSTGRES_PASSWORD=
# Redis requirepass. The compose file refuses to start Redis without it.
REDIS_PASSWORD=
# LiveKit API key/secret pair. MUST match deploy/selfhost/livekit.yaml (the
# installer renders that file from these values). The backend REFUSES TO BOOT
# in production when LIVEKIT_API_SECRET is unset or still the shipped default.
#   openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Bearer for the internal /api/v1/internal/* agent surface. Production
# readiness reports "missing_internal_secret" (503) without it. Keep it
# distinct from LIVEKIT_API_SECRET — they guard different trust boundaries.
INTERNAL_AGENT_SECRET=
# Credential for MINTING/REVOKING gateway agent keys. Falls back to
# INTERNAL_AGENT_SECRET when empty; set it so a leaked internal bearer cannot
# mint durable agent identities.
GATEWAY_KEY_ADMIN_SECRET=
# HMAC key for signed attachment-download URLs. Falls back to the LiveKit
# secret when empty; set it explicitly.
UPLOAD_URL_SECRET=

# --- Identity: Keycloak OIDC — REQUIRED --------------------------------------
# Stable's ONLY auth is Keycloak OIDC. There is no local-account or
# no-auth mode: the backend boots without Keycloak but /health stays 503
# (identity: unavailable) and nobody can sign in. Run the bundled Keycloak
# (COMPOSE_PROFILES includes "keycloak" — the installer imports the realm,
# both clients and your first user automatically) or point these at your own.
#
# KEYCLOAK_URL is BOTH the JWKS fetch base and the expected token issuer, so
# it must be the browser-facing URL *and* be reachable from inside the
# backend container. The bundled setup satisfies both by serving Keycloak
# through the web container's nginx on the app origin:
#   http://<STABLE_HOST>:<STABLE_WEB_PORT>/auth
KEYCLOAK_URL=
KEYCLOAK_REALM=stable
TRUSTED_ISSUER_HOSTS=
# Backend (confidential) client: audience for API tokens; its service account
# powers the people directory (needs realm-management view-users/query-users).
KEYCLOAK_CLIENT_ID=stable-backend
KEYCLOAK_CLIENT_SECRET=
# Browser (public, PKCE) client — written into instances.json for the SPA.
KEYCLOAK_WEB_CLIENT_ID=stable-web
# Bundled-Keycloak-only: its Postgres database + bootstrap admin console user.
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
# First Stable user, created by the realm import (bundled mode only).
STABLE_ADMIN_USER=admin
STABLE_ADMIN_EMAIL=admin@stable.local
STABLE_ADMIN_PASSWORD=

# --- Derived URLs — REQUIRED (installer computes from STABLE_HOST/ports) -----
# Origin shown in emails/links and allowed by CORS.
PUBLIC_BASE_URL=http://example.com:8401
# Comma-separated list (or JSON array) of allowed browser origins.
CORS_ORIGINS=http://example.com:8401
# LiveKit URL handed to BROWSERS in token responses (ws:// or wss://). Must be
# reachable from every client machine.
LIVEKIT_PUBLIC_URL=ws://example.com:7880
# Extra CSP connect-src entries the web nginx allows (LiveKit lives on its own
# port, so 'self' does not cover it).
STABLE_CSP_EXTRA_CONNECT=ws://example.com:7880 http://example.com:7880
# Optional CSP source expressions for operator-provided analytics/auth frames.
STABLE_CSP_EXTRA_SCRIPT=
STABLE_CSP_EXTRA_FRAME=
# nginx upstream for the same-origin /auth proxy (bundled Keycloak).
STABLE_KEYCLOAK_UPSTREAM=keycloak:8080

# --- Build provenance (informational; installer stamps from git) -------------
STABLE_GIT_SHA=unknown
STABLE_GIT_SHA_FULL=unknown
STABLE_BUILD_TIME=unknown
# Optional readiness gates: leave false unless you wire error reporting /
# always deploy stamped images.
READINESS_REQUIRE_BUILD_PROVENANCE=false
READINESS_REQUIRE_OBSERVABILITY=false

# --- General ----------------------------------------------------------------
LOG_LEVEL=INFO
# production (default) = JSON logs, no SQL echo, startup secret guard ON.
ENVIRONMENT=production
# Set a UUID to bind this instance to one org (per-org tenancy). Empty =
# community/ownership isolation.
STABLE_ORG_ID=

# =============================================================================
# OPTIONAL INTEGRATIONS — everything below defaults to OFF / empty and the
# stack is fully functional (chat, calls, rooms, uploads) without it.
# =============================================================================

# --- Brigade agent fleet (OPTIONAL) ------------------------------------------
# Upstream agent backend (LLM routing, personas, org chart). With these unset
# the backend boots and runs normally; agent invites/replies degrade to
# errors in the agent UI surfaces only.
BRIGADE_BASE_URL=
BRIGADE_API_BASE_URL=
BRIGADE_AVATAR_BASE_URL=
BRIGADE_API_KEY=
BRIGADE_WORKER_AGENT_NAME=stable-brigade

# --- Voice: read-aloud TTS + transcription STT proxies (OPTIONAL) ------------
# OpenAI-compatible endpoints. Empty = the read-aloud and mic-transcribe
# buttons return an error when pressed; nothing else is affected.
# TTS: a kokoro-fastapi style server, e.g. http://voice-host:8880
KOKORO_BASE_URL=
TTS_DEFAULT_VOICE=af_heart
# Read-aloud button voice for senders with no per-agent preset (humans,
# plain-model seats). Must not be a named crew voice; see server/app/config.py.
TTS_READ_ALOUD_DEFAULT_VOICE=am_adam
# STT: any OpenAI-compatible /audio/transcriptions base INCLUDING /v1,
# e.g. http://voice-host:9000/v1 (Whisper, Parakeet shim, …)
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1

# --- Web runtime descriptor (OPTIONAL) --------------------------------------
# These values are written to deploy/selfhost/instances.json and are read by
# the landing page, SPA URL safety checks, and the push service worker.
STABLE_ANALYTICS_SCRIPT_URL=
STABLE_ANALYTICS_WEBSITE_ID=
STABLE_APP_URL=
STABLE_MARKETING_BASE_URL=
STABLE_CONTACT_EMAIL=
STABLE_SOURCE_URL=

# --- Agent runtime voice/LLM providers (OPTIONAL; used with profile "agents") -
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Document RAG / Knowledge Bases (OPTIONAL) -------------------------------
# Chat-with-your-documents needs a Qdrant vector store + an Infinity-style
# embeddings/rerank service, which are NOT bundled. Leave RAG_ENABLED=false
# unless you run them; KB uploads still store files either way.
RAG_ENABLED=false
QDRANT_URL=
INFINITY_URL=
CONTEXT_ENABLED=false
CONTEXT_LLM_URL=

# Optional help assistant upstream. Empty/unset uses the neutral local default.
HELP_AGENT_BASE_URL=

# --- Meeting-Ops transcript federation (OPTIONAL) ----------------------------
# Forward finalized call transcripts to a Meeting-Ops instance. Enabling this
# with an incomplete URL/PAT/org configuration FAILS THE BOOT on purpose.
MEETING_OPS_ENABLED=false
MEETING_OPS_URL=
MEETING_OPS_INGEST_PATH=/api/v1/sessions/ingest
MEETING_OPS_API_KEY=
MEETING_OPS_ORG_SLUG=

# --- Email via Microsoft Graph (OPTIONAL; invites/notifications) -------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=

# --- Web Push (OPTIONAL; empty = push disabled) ------------------------------
# Generate a VAPID pair, e.g.: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Incoming webhooks (OPTIONAL; empty = endpoint disabled) -----------------
# Enables POST /webhooks/incoming/{secret}/{room} (Slack-shaped payloads).
INCOMING_WEBHOOK_SECRET=

# --- Project-Ops promotion (OPTIONAL) ----------------------------------------
# Least-privilege Project-Ops PAT for read:projects/read:tasks. When set, it
# takes precedence over the legacy service JWT.
PROJECTOPS_SERVICE_PAT=
PROJECTOPS_SERVICE_JWT=
PROJECTOPS_MCP_URL=
PROJECTOPS_DASHBOARD_URL=

# --- Error reporting: Sentry/GlitchTip (OPTIONAL) ----------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Federation server rail (OPTIONAL) ---------------------------------------
# Point at a JSON array of instance descriptors to show multiple Stable
# servers in the left rail (see deploy/instances/dogfood.json for the shape).
# The installer generates a single-instance deploy/selfhost/instances.json.
# STABLE_INSTANCES_FILE=./deploy/selfhost/instances.json
