# =============================================================================
# Stable — Environment Configuration
# Copy to .env and fill in production values
# =============================================================================

# --- Database ---
POSTGRES_PASSWORD=stable_dev_password_2026

# --- LiveKit ---
LIVEKIT_API_KEY=APIStable2026
LIVEKIT_API_SECRET=stable_secret_change_in_production_2026

# --- Keycloak (OIDC) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=stable
KEYCLOAK_CLIENT_SECRET=

# --- Brigade agent registry ---
BRIGADE_BASE_URL=https://brigade.magicunicorn.dev/api/v1/openai/v1
BRIGADE_AVATAR_BASE_URL=https://brigade.magicunicorn.dev/avatars
BRIGADE_API_KEY=

# --- AI Providers (agents need at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Voice Pipeline (agents) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8401

# --- Logging ---
LOG_LEVEL=INFO

# Dedicated bearer for backend callbacks from the agent runtime. Production
# readiness and append-only agent-audit ingestion require this to be set; do
# not reuse LIVEKIT_API_SECRET.
# Generate with: openssl rand -base64 48
INTERNAL_AGENT_SECRET=

# Error/performance reporting (Sentry or Sentry-compatible GlitchTip).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Enterprise gates: provenance is enabled by compose; turn observability on
# after the DSN/alert destination is provisioned.
READINESS_REQUIRE_BUILD_PROVENANCE=true
READINESS_REQUIRE_OBSERVABILITY=false

# --- Meeting-Ops transcript federation (optional) --------------------------
# When set, POST /api/v1/rooms/{id}/transcripts/export forwards finalized call
# transcripts to Meeting-Ops. URL + PAT + organization are all required for
# delivery; incomplete configuration retains exports in the durable blocked
# queue. Never commit real keys.
# MEETING_OPS_URL=https://meetingops.example.com
# MEETING_OPS_INGEST_PATH=/api/v1/sessions/ingest
# MEETING_OPS_API_KEY=
# MEETING_OPS_ORG_SLUG=magic-unicorn
# MEETING_OPS_ENABLED=true

# --- Federation server rail ------------------------------------------------
# The web image bakes an EMPTY instances.json, which is the correct default for
# a single-instance deploy. To federate — i.e. to show other Stable servers in
# the left-hand ServerRail — point this at a JSON array of instance descriptors
# (see deploy/instances/dogfood.json). Path is relative to the repo root.
# scripts/deploy.sh asserts after every `web` deploy that what this file
# contains is what the site actually serves.
# STABLE_INSTANCES_FILE=./deploy/instances/dogfood.json

# Credential for gateway KEY MANAGEMENT (mint / list / revoke) only. Kept
# separate from INTERNAL_AGENT_SECRET on purpose: that one secret authenticates
# every /api/v1/internal/* route, so reusing it for key administration means a
# single leak lets an attacker mint agent identities. Leave UNSET to keep the
# previous behaviour (key admin falls back to INTERNAL_AGENT_SECRET) — setting it
# is what activates the split.
# GATEWAY_KEY_ADMIN_SECRET=
